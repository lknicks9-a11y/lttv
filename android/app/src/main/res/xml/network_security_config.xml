<?xml version="1.0" encoding="utf-8"?>
<!-- Many IPTV playlists, guides and streams are served over plain HTTP (often on the local network). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
