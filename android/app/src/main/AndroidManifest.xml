<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- In-app updates: download the new APK and hand it to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- TV first: no touchscreen required; leanback launcher supported but not required (phones/tablets can install too). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.LTTV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- "LTTV League Pass" (NBA) and "LTTV Blitz" (NFL): their own tiles, opening straight into each. -->
        <activity-alias
            android:name=".LeaguePassAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/leaguepass_name"
            android:banner="@drawable/banner_leaguepass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".BlitzAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/blitz_name"
            android:banner="@drawable/banner_blitz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The streaming apps (LTTV Fresh, Binge, Prestige, Peak, Family, Spark, Bright, Studio, Library):
             every movie and show from your playlists, by the service it streams on. -->
        <activity-alias
            android:name=".FreshAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/fresh_name"
            android:banner="@drawable/banner_fresh">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".BingeAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/binge_name"
            android:banner="@drawable/banner_binge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".PrestigeAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/prestige_name"
            android:banner="@drawable/banner_prestige">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".PeakAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/peak_name"
            android:banner="@drawable/banner_peak">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".FamilyAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/family_name"
            android:banner="@drawable/banner_family">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".SparkAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/spark_name"
            android:banner="@drawable/banner_spark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".BrightAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/bright_name"
            android:banner="@drawable/banner_bright">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".StudioAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/studio_name"
            android:banner="@drawable/banner_studio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LibraryAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/library_name"
            android:banner="@drawable/banner_library">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
