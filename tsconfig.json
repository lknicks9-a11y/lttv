{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker.ImportScripts"
    ],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": [
      "node"
    ],
    "paths": {
      "preact": [
        "./vendor/preact/src/index.d.ts"
      ],
      "preact/hooks": [
        "./vendor/preact/hooks/src/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}